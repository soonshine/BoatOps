{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://boatops.ayany.com/contracts/inventory-provider/v1/events/resource.unblocked.v1.schema.json",
  "title": "resource.unblocked.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "event_type", "event_version", "occurred_at", "organization_id", "aggregate_type", "aggregate_id", "block_id", "boat_id", "inventory_revision", "status"],
  "properties": {
    "event_id": {"type": "string", "format": "uuid"},
    "event_type": {"const": "resource.unblocked.v1"},
    "event_version": {"const": 1},
    "occurred_at": {"type": "string", "format": "date-time"},
    "organization_id": {"type": "integer", "minimum": 1},
    "aggregate_type": {"const": "block"},
    "aggregate_id": {"type": "integer", "minimum": 1},
    "block_id": {"type": "integer", "minimum": 1},
    "boat_id": {"type": "integer", "minimum": 1},
    "inventory_revision": {"type": "integer", "minimum": 1},
    "status": {"const": "RELEASED"}
  }
}
